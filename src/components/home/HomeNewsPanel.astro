---
import HomePanel from './HomePanel.astro';
import SectionHead from '../SectionHead.astro';
import NewsList from '../NewsList.astro';
import { news } from '../../data/news';
---

<HomePanel id="news" section="news">
	<SectionHead
		eyebrow="News"
		title="新闻动态"
		href="/news"
		description="关注公司动态、技术进展与招聘资讯。"
	/>
	<div class="panel-body">
		<NewsList items={news.slice(0, 3)} compact />
	</div>
</HomePanel>

<style>
	.panel-body {
		flex: 1 1 auto;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.panel-body :global(.news-list) {
		flex: 1 1 auto;
		min-height: 0;
		height: 100%;
	}
</style>
