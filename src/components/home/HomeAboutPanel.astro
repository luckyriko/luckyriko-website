---
import HomePanel from './HomePanel.astro';
import SectionTitleLink from '../SectionTitleLink.astro';
import StatGrid from '../StatGrid.astro';
import { about } from '../../data/about';
---

<HomePanel id="about" section="about" class="about-band">
	<div class="about-grid">
		<div class="about-copy reveal">
			<span class="eyebrow">About Us</span>
			<h2>
				<SectionTitleLink href="/about" label="了解我们" />
			</h2>
			<p>{about.intro}</p>
		</div>
		<StatGrid items={about.stats} />
	</div>
</HomePanel>

<style>
	:global(.home-panel.about-band) {
		background: color-mix(in srgb, var(--mh-surface-2) 88%, transparent);
		border-block: 1px solid var(--mh-line);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: clamp(1.25rem, 4vw, 2.5rem);
		align-items: center;
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
	}

	.about-copy .eyebrow {
		display: inline-block;
		margin-bottom: 0.5rem;
		font-family: var(--mh-font-display);
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--mh-accent);
	}

	.about-copy h2 {
		margin: 0 0 0.75rem;
		font-family: var(--mh-font-display);
		font-size: clamp(1.6rem, 3.5vw, 2.3rem);
		line-height: 1.2;
	}

	.about-copy p {
		margin: 0;
		color: var(--mh-muted);
		line-height: 1.65;
		max-width: 36rem;
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 900px) {
		.about-grid {
			grid-template-columns: 1fr;
			align-content: center;
		}

		.about-copy p {
			-webkit-line-clamp: 3;
		}
	}
</style>
