---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<header class="site-header" data-header>
	<div class="container-wide header-inner">
		<a
			class="brand"
			href={isHome ? '#home' : '/'}
			aria-label={`${site.name} 首页`}
			data-nav-section={isHome ? 'home' : undefined}
		>
			<svg class="brand-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
				<path
					fill="currentColor"
					d="M6 26V6h4.2l5.8 12.4L21.8 6H26v20h-3.6V12.2L17.2 24h-2.4L9.6 12.2V26H6z"
				></path>
			</svg>
			<span class="brand-text">
				<span class="brand-cn">{site.name}</span>
				<span class="brand-en">{site.nameEn}</span>
			</span>
		</a>

		<button
			type="button"
			class="nav-toggle"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="打开导航菜单"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<nav class="site-nav" id="site-nav" data-nav>
			<ul>
				{
					site.nav.map((item) => {
						const href = isHome ? `#${item.section}` : item.href;
						const active = !isHome && (item.href === '/' ? pathname === '/' : pathname === item.href || pathname.startsWith(`${item.href}/`));
						return (
							<li>
								<a
									href={href}
									data-nav-section={item.section}
									aria-current={active ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
			<div class="nav-actions">
				<ThemeToggle />
			</div>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		backdrop-filter: blur(14px);
		background: var(--mh-nav-bg);
		border-bottom: 1px solid transparent;
		transition:
			border-color 0.35s var(--mh-ease),
			background 0.35s var(--mh-ease),
			backdrop-filter 0.35s var(--mh-ease),
			transform 0.35s var(--mh-ease),
			opacity 0.35s var(--mh-ease);
	}

	.site-header.is-scrolled {
		border-bottom-color: var(--mh-line);
	}

	/* 首页首屏：仅保留左上角 logo */
	:global(body.page-home) .site-header {
		position: fixed;
		inset: 0 0 auto 0;
		width: 100%;
		background: transparent;
		backdrop-filter: none;
		border-bottom-color: transparent;
		color: #f5f8ff;
	}

	:global(body.page-home) .site-header .brand-en {
		color: color-mix(in srgb, #fff 70%, transparent);
	}

	:global(body.page-home) .site-header:not(.is-revealed) .site-nav,
	:global(body.page-home) .site-header:not(.is-revealed) .nav-toggle {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-8px);
		transition:
			opacity 0.35s var(--mh-ease),
			visibility 0.35s var(--mh-ease),
			transform 0.35s var(--mh-ease);
	}

	:global(body.page-home) .site-header.is-revealed {
		background: var(--mh-nav-bg);
		backdrop-filter: blur(14px);
		color: var(--mh-text);
		border-bottom-color: var(--mh-line);
	}

	:global(body.page-home) .site-header.is-revealed .brand-en {
		color: var(--mh-muted);
	}

	:global(body.page-home) .site-header.is-revealed .nav-toggle {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: none;
	}

	@media (min-width: 861px) {
		:global(body.page-home) .site-header.is-revealed .site-nav {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
		}
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 4.25rem;
		gap: 1rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
	}

	.brand-mark {
		flex-shrink: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.05;
	}

	.brand-cn {
		font-family: var(--mh-font-display);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.brand-en {
		font-family: var(--mh-font-display);
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--mh-muted);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.site-nav ul {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav a {
		position: relative;
		display: inline-block;
		padding: 0.55rem 0.85rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--mh-muted);
		transition: color 0.25s var(--mh-ease);
	}

	.site-nav a::after {
		content: '';
		position: absolute;
		left: 0.85rem;
		right: 0.85rem;
		bottom: 0.2rem;
		height: 1.5px;
		background: var(--mh-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s var(--mh-ease);
	}

	.site-nav a:hover,
	.site-nav a[aria-current='page'] {
		color: var(--mh-text);
	}

	.site-nav a[aria-current='page']::after,
	.site-nav a:hover::after {
		transform: scaleX(1);
	}

	.nav-actions {
		display: flex;
		align-items: center;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid var(--mh-line);
		border-radius: 0.25rem;
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle span {
		display: block;
		width: 1.1rem;
		height: 1.5px;
		margin-inline: auto;
		background: currentColor;
		transition: transform 0.25s var(--mh-ease), opacity 0.25s var(--mh-ease);
	}

	.nav-toggle[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}

	.nav-toggle[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	@media (max-width: 860px) {
		.nav-toggle {
			display: inline-flex;
		}

		.site-nav {
			position: fixed;
			inset: 4.25rem 0 auto 0;
			display: grid;
			gap: 1rem;
			padding: 1rem 1.25rem 1.25rem;
			background: var(--mh-paper-elevated);
			border-bottom: 1px solid var(--mh-line);
			transform: translateY(-120%);
			opacity: 0;
			pointer-events: none;
			transition:
				transform 0.35s var(--mh-ease),
				opacity 0.35s var(--mh-ease);
		}

		.site-nav.is-open {
			transform: none;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}

		.site-nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0.15rem;
		}

		.site-nav a {
			padding: 0.85rem 0.4rem;
		}

		.site-nav a::after {
			display: none;
		}

		.nav-actions {
			justify-content: flex-start;
			padding-top: 0.35rem;
			border-top: 1px solid var(--mh-line);
		}

		:global(body.page-home) .site-header:not(.is-revealed) .nav-toggle {
			border-color: color-mix(in srgb, #fff 35%, transparent);
		}
	}
</style>
