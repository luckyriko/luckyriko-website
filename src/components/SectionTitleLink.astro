---
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="section-title-link" href={href}>
	{label}
	<span class="title-arrow" aria-hidden="true">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
			<path
				d="M5 12h12.5M13 6l6 6-6 6"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
	</span>
</a>

<style>
	.section-title-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: inherit;
		text-decoration: none;
		font: inherit;
		transition: color 0.25s var(--mh-ease);
	}

	.section-title-link:hover {
		color: var(--mh-accent);
	}

	.title-arrow {
		display: inline-grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
		border-radius: 999px;
		color: var(--mh-accent);
		line-height: 0;
		transition:
			transform 0.25s var(--mh-ease),
			border-color 0.25s var(--mh-ease),
			background 0.25s var(--mh-ease);
	}

	.title-arrow svg {
		display: block;
		width: 0.85rem;
		height: 0.85rem;
	}

	.section-title-link:hover .title-arrow {
		transform: translateX(3px);
		border-color: var(--mh-accent);
		background: color-mix(in srgb, var(--mh-accent) 10%, transparent);
	}
</style>
