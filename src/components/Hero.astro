---
import { site } from '../data/site';

interface Props {
	video?: string;
	poster?: string;
}

const { video = '/videos/hero.mp4', poster = '/images/bg.jfif' } = Astro.props;
---

<section class="hero" data-home-hero aria-label="品牌主视觉">
	<div class="hero-media" aria-hidden="true">
		<video
			class="hero-video"
			data-hero-video
			src={video}
			poster={poster}
			autoplay
			muted
			loop
			playsinline
			webkit-playsinline
			preload="auto"
		></video>
		<div class="hero-overlay"></div>
	</div>

	<div class="hero-content">
		<p class="hero-brand">{site.nameEn}</p>
		<h1>
			<span class="hero-cn">{site.name}</span>
			<span class="hero-slogan">{site.slogan}</span>
		</h1>
		<p class="hero-lead">{site.sloganZh} —— 为用户提供美好的、超出预期的产品与内容。</p>
	</div>

	<p class="hero-hint" aria-hidden="true">向下滚动探索</p>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		height: 100%;
		min-height: 100%;
		display: grid;
		place-items: center;
		color: var(--mh-text-inverse);
		overflow: hidden;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: #070b14;
	}

	.hero-video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		background: #070b14;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			radial-gradient(ellipse at center, transparent 20%, rgba(4, 8, 16, 0.55) 100%),
			linear-gradient(180deg, rgba(4, 8, 16, 0.35) 0%, rgba(4, 8, 16, 0.55) 100%);
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: min(40rem, calc(100% - 2.5rem));
		text-align: center;
		padding-block: 1rem;
	}

	.hero-brand {
		margin: 0 0 1.1rem;
		font-family: var(--mh-font-display);
		font-size: clamp(2.8rem, 9vw, 5.4rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		line-height: 0.95;
	}

	.hero h1 {
		margin: 0 0 1.15rem;
		display: grid;
		gap: 0.55rem;
		justify-items: center;
	}

	.hero-cn {
		font-family: var(--mh-font-display);
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		font-weight: 600;
		letter-spacing: 0.28em;
	}

	.hero-slogan {
		font-family: var(--mh-font-display);
		font-size: clamp(0.72rem, 1.5vw, 0.9rem);
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		opacity: 0.82;
	}

	.hero-lead {
		margin: 0 auto;
		max-width: 28rem;
		font-size: clamp(0.98rem, 2vw, 1.1rem);
		line-height: 1.75;
		color: color-mix(in srgb, #fff 84%, transparent);
	}

	.hero-hint {
		position: absolute;
		left: 50%;
		bottom: 1.5rem;
		z-index: 2;
		margin: 0;
		transform: translateX(-50%);
		font-family: var(--mh-font-display);
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, #fff 65%, transparent);
		animation: hint-bounce 2s ease-in-out infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-hint {
			animation: none;
		}
	}

	@keyframes hint-bounce {
		0%,
		100% {
			transform: translate(-50%, 0);
			opacity: 0.55;
		}
		50% {
			transform: translate(-50%, 6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.hero-cn {
			letter-spacing: 0.16em;
		}
	}
</style>
