---
import type { NewsItem } from '../data/news';

interface Props {
	items: NewsItem[];
	compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<div class:list={['news-list', { compact }]}>
	{
		items.map((item) => (
			<article class="news-item reveal">
				<a class="news-link" href={`/news/${item.slug}`}>
					<figure class="news-visual">
						<img src={item.image} alt="" width="640" height="400" loading="lazy" decoding="async" />
					</figure>
					<div class="news-body">
						<p class="news-meta">
							<span>{item.category}</span>
							<time datetime={item.date}>{item.date}</time>
						</p>
						<h3>{item.title}</h3>
						<p class="news-summary">{item.summary}</p>
					</div>
				</a>
			</article>
		))
	}
</div>

<style>
	.news-list {
		display: grid;
		gap: 1.25rem;
	}

	.news-list.compact {
		height: 100%;
		min-height: 0;
		gap: 0.55rem;
		grid-template-rows: repeat(3, minmax(0, 1fr));
		overflow: hidden;
	}

	.news-list.compact .news-item {
		min-height: 0;
		overflow: hidden;
	}

	.news-link {
		display: grid;
		grid-template-columns: minmax(160px, 280px) 1fr;
		gap: 1.25rem;
		align-items: stretch;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--mh-line);
		transition: opacity 0.25s var(--mh-ease);
	}

	.news-list.compact .news-link {
		height: 100%;
		gap: 0.9rem;
		padding-bottom: 0.55rem;
		grid-template-columns: minmax(110px, 180px) 1fr;
		align-items: center;
	}

	.news-link:hover {
		opacity: 0.92;
	}

	.news-visual {
		margin: 0;
		overflow: hidden;
		background: var(--mh-surface-2);
		aspect-ratio: 16 / 10;
	}

	.news-list.compact .news-visual {
		height: 100%;
		max-height: 108px;
		aspect-ratio: auto;
	}

	.news-visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--mh-ease);
	}

	.news-link:hover .news-visual img {
		transform: scale(1.03);
	}

	.news-body {
		display: grid;
		align-content: center;
		gap: 0.45rem;
		padding-block: 0.2rem;
		min-width: 0;
	}

	.news-list.compact .news-body {
		gap: 0.25rem;
	}

	.news-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		color: var(--mh-muted);
	}

	.news-meta span {
		color: var(--mh-accent);
		font-weight: 600;
	}

	h3 {
		margin: 0;
		font-family: var(--mh-font-display);
		font-size: clamp(1.15rem, 2.4vw, 1.4rem);
		font-weight: 650;
		line-height: 1.35;
	}

	.news-list.compact h3 {
		font-size: clamp(1rem, 2vw, 1.2rem);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.news-summary {
		margin: 0;
		color: var(--mh-muted);
		line-height: 1.65;
	}

	.news-list.compact .news-summary {
		line-height: 1.5;
		font-size: 0.92rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 700px) {
		.news-link,
		.news-list.compact .news-link {
			grid-template-columns: 96px 1fr;
			gap: 0.75rem;
		}

		.news-list.compact .news-visual {
			max-height: 72px;
		}

		.news-list.compact .news-summary {
			-webkit-line-clamp: 1;
		}
	}
</style>
