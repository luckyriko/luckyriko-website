---
interface Props {
	items: readonly { label: string; value: string }[];
}

const { items } = Astro.props;
---

<ul class="stat-grid reveal reveal-delay-1">
	{
		items.map((item) => (
			<li>
				<strong>{item.value}</strong>
				<span>{item.label}</span>
			</li>
		))
	}
</ul>

<style>
	.stat-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.85rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stat-grid li {
		padding: 1rem 0.95rem;
		border-top: 2px solid var(--mh-accent);
		background: color-mix(in srgb, var(--mh-paper-elevated) 80%, transparent);
	}

	.stat-grid strong {
		display: block;
		margin-bottom: 0.3rem;
		font-family: var(--mh-font-display);
		font-size: clamp(1.4rem, 2.8vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.stat-grid span {
		color: var(--mh-muted);
		font-size: 0.9rem;
	}
</style>
