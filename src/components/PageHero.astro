---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultImage from "../assets/page-default.jpg";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  image?: ImageMetadata;
}

const { title, description, eyebrow, image = defaultImage } = Astro.props;
---

<header class="page-hero">
  <div class="page-hero-media" aria-hidden="true">
    <Image
      src={image}
      alt=""
      width="1800"
      height="900"
      decoding="async"
      fetchpriority="high"
    />
    <div class="page-hero-overlay"></div>
  </div>
  <div class="container-wide page-hero-content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p class="desc">{description}</p>}
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    min-height: min(48svh, 420px);
    display: grid;
    align-items: end;
    color: var(--mh-text-inverse);
    overflow: hidden;
  }

  .page-hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .page-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--mh-hero-overlay);
  }

  .page-hero-content {
    padding-block: 5.5rem 2.75rem;
    max-width: 40rem;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    font-family: var(--mh-font-display);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mh-accent-soft);
  }

  h1 {
    margin: 0 0 0.85rem;
    font-family: var(--mh-font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .desc {
    margin: 0;
    color: color-mix(in srgb, #fff 80%, transparent);
    font-size: 1.05rem;
    line-height: 1.7;
  }
</style>
