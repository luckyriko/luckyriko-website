---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HomePanel from '../components/home/HomePanel.astro';
import HomeProductsPanel from '../components/home/HomeProductsPanel.astro';
import HomeAboutPanel from '../components/home/HomeAboutPanel.astro';
import HomeCareersPanel from '../components/home/HomeCareersPanel.astro';
import HomeNewsPanel from '../components/home/HomeNewsPanel.astro';
import { site } from '../data/site';
---

<BaseLayout title={`${site.name} · ${site.slogan}`} description={site.description}>
	<div class="home-panels">
		<HomePanel id="home" section="home" bare>
			<Hero />
		</HomePanel>
		<HomeProductsPanel />
		<HomeAboutPanel />
		<HomeCareersPanel />
		<HomeNewsPanel />
	</div>
</BaseLayout>

<style>
	.home-panels {
		position: relative;
	}
</style>
